APP_ENV=development
APP_NAME="TeamXsparK Renewable Distribution Grid Digital Twin"
API_PREFIX=/api

# Supabase Credentials (Optional for local memory mode; provide real keys for cloud Supabase PostgreSQL)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Model Storage
MODEL_PATH=./data/models

# Logging
LOG_LEVEL=INFO
