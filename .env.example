# Renewable Distribution Grid Digital Twin - Environment Configuration

# API Base URL for future FastAPI backend integration
VITE_API_BASE_URL=http://localhost:8000/api

# Set to true to use built-in realistic mock service layer (default for frontend demo)
# Set to false when connecting to the real FastAPI backend
VITE_USE_MOCK_API=true

# Mock API artificial latency simulation in ms (0 to disable)
VITE_MOCK_LATENCY_MS=300
